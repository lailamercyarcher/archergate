{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcherGate Alpha",
  "version": "0.3.0-alpha.1",
  "identifier": "com.archergate.medialab.alpha",
  "mainBinaryName": "archergate",
  "build": {"frontendDist": "../desktop/ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {"capabilities": ["workspace"]}
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {"payload/": "payload/"},
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller", "silent": true},
      "nsis": {"installMode": "currentUser"}
    }
  }
}
